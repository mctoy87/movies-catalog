{
  "name": "moviescatalog",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "backend",
    "webapp2"
  ],
  "scripts": {
    "types": "concurrently \"npm -prefix backend run types\" \"npm -prefix webapp2 run types\"",
    "b:dev": "npm run --workspace backend dev",
    "w:dev": "npm run --workspace webapp2 dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
